{
  "name": "@neuraiproject/neurai-silent-payments",
  "version": "0.1.0",
  "description": "NIP-047 silent payments for Neurai (strict ECDSA witness v3): payment codes, sender outputs and receiver scanning",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./global": "./dist/NeuraiSilentPayments.global.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && rollup -c",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && npm run typecheck && vitest run test/unit.test.mjs test/index.test.mjs test/dist.test.mjs",
    "test:determinism": "npm run build && node test/determinism.mjs",
    "test:regtest": "npm run build && node test/regtest/run.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neuraiproject/neurai-silent-payments.git"
  },
  "keywords": [
    "Neurai",
    "silent payments",
    "NIP-047",
    "secp256k1",
    "bech32m"
  ],
  "author": "Neuraiproject",
  "license": "MIT",
  "dependencies": {
    "@noble/curves": "^2.0.0",
    "@noble/hashes": "^2.0.0",
    "@scure/base": "^2.4.0",
    "@scure/bip39": "^2.0.1"
  },
  "devDependencies": {
    "@neuraiproject/neurai-key": "^5.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^20.19.27",
    "rollup": "^4.60.1",
    "rollup-plugin-dts": "^6.4.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  }
}
